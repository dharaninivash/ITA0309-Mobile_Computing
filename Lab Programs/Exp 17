Python: frequency (co-channel) reuse, cluster size, capacity and S/I 

import math
import numpy as np
import matplotlib.pyplot as plt


def analyze_cluster(i, j, total_channels, number_of_cells, path_loss_exponent=4, interferers=6):
    """N=i^2+ij+j^2, Q=sqrt(3N), S/I~Q^n / interferers."""
    n = i * i + i * j + j * j
    q = math.sqrt(3 * n)
    sir_linear = (q ** path_loss_exponent) / interferers
    channels_per_cell = total_channels // n
    return (n, q, 10 * math.log10(sir_linear), channels_per_cell,
            channels_per_cell * number_of_cells)

spectrum_mhz = 25.0
channel_width_khz = 200.0
number_of_cells = 120
total_channels = int(spectrum_mhz * 1000 // channel_width_khz)
cluster_pairs = [(1, 1), (2, 0), (2, 1), (3, 0), (2, 2)]
results = [analyze_cluster(i, j, total_channels, number_of_cells)
           for i, j in cluster_pairs]

print(f"Available channels: {total_channels}; cells in network: {number_of_cells}")
print("  N   Reuse Q   S/I (dB)   Ch/cell   Network capacity")
for n, q, sir, per_cell, network_capacity in results:
    print(f"{n:3d}   {q:7.2f}     {sir:7.2f}     {per_cell:7d}      {network_capacity:7d}")

ns = [row[0] for row in results]
sir_values = [row[2] for row in results]
capacities = [row[4] for row in results]
fig, axs = plt.subplots(1, 2, figsize=(11, 4))
axs[0].plot(ns, sir_values, marker="o")
axs[0].set(title="S/I improves with larger clusters", xlabel="Cluster size N", ylabel="S/I (dB)")
axs[1].bar([str(n) for n in ns], capacities)
axs[1].set(title="Reuse capacity trade-off", xlabel="Cluster size N", ylabel="Approx. concurrent channels")
for ax in axs:
    ax.grid(axis="y", alpha=0.3)
fig.tight_layout()
plt.show()
